# Copy this file to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------------
# Database name required by the assessment: bd_<name>_<lastname>_<clan>
POSTGRES_DB=bd_juanjose_giraldo_thompson
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Role used by the API. It has no BYPASSRLS, so row level security always applies.
APP_DB_USER=rw_app
APP_DB_PASSWORD=change_me_too

# Used by scripts running on the host (migrations, seed, embedding indexer).
DATABASE_URL=postgresql://rw_app:change_me_too@localhost:5432/bd_juanjose_giraldo_thompson
# Owner connection, only for migrations that need to create roles and extensions.
DATABASE_ADMIN_URL=postgresql://postgres:change_me@localhost:5432/bd_juanjose_giraldo_thompson

# --- API ----------------------------------------------------------------------
API_PORT=4000
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_with_openssl_rand_hex_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:3000

# --- AI providers -------------------------------------------------------------
# Chat and embeddings are two independent providers behind the same OpenAI compatible
# interface. Swapping either one is a change to these variables, not to the code.

# Chat: NVIDIA NIM
AI_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
AI_CHAT_API_KEY=nvapi-your-key-here
AI_CHAT_MODEL=openai/gpt-oss-20b

# Embeddings: Ollama running on the host.
# Use localhost when the API runs on the host (npm run api:dev) and
# host.docker.internal when it runs inside docker compose.
AI_EMBEDDING_BASE_URL=http://localhost:11434/v1
AI_EMBEDDING_API_KEY=ollama
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768

# --- Web ----------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
