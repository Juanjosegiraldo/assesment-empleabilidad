{
  "name": "riwi-messaging",
  "version": "0.1.0",
  "private": true,
  "description": "Internal messaging platform for Riwi Co. S.A.S. with an AI copilot",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "bash db/scripts/migrate.sh",
    "db:seed": "tsx db/scripts/load-seed.ts",
    "db:psql": "docker compose exec db psql -U $POSTGRES_USER -d $POSTGRES_DB",
    "api:dev": "npm run dev -w @riwi/api",
    "db:index": "tsx db/scripts/index-embeddings.ts",
    "web:dev": "npm run dev -w @riwi/web"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
